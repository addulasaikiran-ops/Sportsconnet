# Copy this file to .env.local and fill in values from your Supabase project.
# Use the project URL and publishable key (or legacy anon key); never put service_role keys in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional fallback for projects still showing the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
