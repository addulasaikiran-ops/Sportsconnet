# Copy this file to .env.local and fill in values from your Supabase project.
# Use the project URL and publishable key (or legacy anon key); never put service_role keys in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://bzdtywxwehjpsheirfup.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mnf4hhgbpUDWEgawBnu7Wg_qjZPTZx6

# Optional fallback for projects still showing the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Shared rate limiting for serverless deployments (Upstash Redis REST).
# Create a database at https://upstash.com/ and set these only in server-side env vars.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional error tracking. Create a Sentry project for Next.js at https://sentry.io/
# Browser DSN is designed to be public; keep SENTRY_DSN and SENTRY_AUTH_TOKEN server-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional deployment/environment label, e.g. production or staging.
APP_ENV=
NEXT_PUBLIC_APP_ENV=
